{
  "entities": {
    "User": {
      "title": "User",
      "description": "System user with specific role and permissions.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "manager", "viewer"] },
        "status": { "type": "string", "enum": ["approved", "pending", "blocked"] },
        "group": { "type": "string", "enum": ["A", "B", "C", "D", "E"] },
        "disabled": { "type": "boolean" },
        "isEmailVerifiedOverride": { "type": "boolean" },
        "emailVerifiedInAuth": { "type": "boolean" },
        "mustChangePassword": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "createdAt"]
    },
    "AllowedDomain": {
      "title": "Allowed Domain",
      "description": "A domain authorized for user registration.",
      "type": "object",
      "properties": {
        "domain": { "type": "string" },
        "addedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["domain", "addedBy", "createdAt"]
    },
    "Metric": {
      "title": "Performance Metric",
      "description": "Performance data for dashboards.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "number" },
        "category": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" }
      },
      "required": ["name", "value", "timestamp"]
    },
    "DDSSession": {
      "title": "DDS Session",
      "description": "Daily Safety Talk session created by admin or imported.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "shift": { "type": "string", "enum": ["Turno 1", "Turno 2", "Turno 3"] },
        "group": { "type": "string", "enum": ["A", "B", "C", "D", "E"] },
        "executor": { "type": "string" },
        "totalPrevisto": { "type": "number" },
        "passcode": { "type": "string" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "importedAt": { "type": "string", "format": "date-time" },
        "legacyId": { "type": "string" }
      },
      "required": ["title", "shift", "group", "executor", "createdAt"]
    },
    "DDSSignature": {
      "title": "DDS Signature",
      "description": "User participation record for a DDS.",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "registration": { "type": "string" },
        "sessionTitle": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "mood": { "type": "string", "enum": ["happy", "neutral", "sad"] },
        "passcode": { "type": "string" },
        "importedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "userId", "timestamp"]
    },
    "Forklift": {
      "title": "Forklift",
      "description": "Equipment identification and current status.",
      "type": "object",
      "properties": {
        "number": { "type": "string" },
        "sector": { "type": "string" },
        "status": { "type": "string", "enum": ["liberada", "bloqueada"] },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["number", "sector", "status", "createdAt"]
    },
    "ForkliftCheckItem": {
      "title": "Forklift Check Item",
      "description": "Inspection criteria defined by admin.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["boolean", "numeric", "normal_anormal", "open_closed"] },
        "unit": { "type": "string", "description": "Unit label like bar, psi, etc." },
        "active": { "type": "boolean" },
        "showStatusSelection": { "type": "boolean", "description": "For numeric items, whether to show normal/anormal selector." },
        "order": { "type": "integer" },
        "addedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "type", "order", "active", "createdAt"]
    },
    "ForkliftChecklist": {
      "title": "Forklift Checklist",
      "description": "Inspection record performed by operator.",
      "type": "object",
      "properties": {
        "forkliftId": { "type": "string" },
        "forkliftNumber": { "type": "string" },
        "conductorId": { "type": "string" },
        "conductorName": { "type": "string" },
        "status": { "type": "string", "enum": ["normal", "anormal"] },
        "itemResults": { 
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "value": { "type": "any" },
              "status": { "type": "string", "enum": ["normal", "anormal"] },
              "observation": { "type": "string" },
              "mediaUrl": { "type": "string" }
            }
          }
        },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["forkliftId", "conductorId", "status", "timestamp"]
    },
    "GlobalSettings": {
      "title": "Global Settings",
      "description": "System-wide configuration settings.",
      "type": "object",
      "properties": {
        "autoNotifyNonConformity": { "type": "boolean" },
        "autoLockOnNonConformity": { "type": "boolean" },
        "responsiblePersons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "email": { "type": "string" }
            },
            "required": ["name", "email"]
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      }
    },
    "Notification": {
      "title": "Notification",
      "description": "Alerts for non-conformities.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["non_conformity"] },
        "message": { "type": "string" },
        "forkliftNumber": { "type": "string" },
        "checklistId": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "ProductionLine": {
      "title": "Production Line",
      "description": "A production line letter or name.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "active": { "type": "boolean" },
        "order": { "type": "integer" }
      },
      "required": ["name", "active"]
    },
    "WireSupplier": {
      "title": "Wire Supplier",
      "description": "Supplier of the wire coils (e.g., Belgo, Morlan).",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["name", "active"]
    },
    "WireBatch": {
      "title": "Wire Batch",
      "description": "A batch of wire coils receiving (Nota Fiscal load).",
      "type": "object",
      "properties": {
        "nfNumber": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "responsibleId": { "type": "string" },
        "responsibleName": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "totalWeight": { "type": "number" },
        "coilsCount": { "type": "number" },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nfNumber", "supplierId", "date", "status", "createdAt"]
    },
    "WireCoil": {
      "title": "Wire Coil",
      "description": "Individual coil of wire.",
      "type": "object",
      "properties": {
        "coilNumber": { "type": "string" },
        "batchId": { "type": "string" },
        "supplierId": { "type": "string" },
        "diameter": { "type": "number" },
        "weight": { "type": "number" },
        "status": { "type": "string", "enum": ["received", "in_use", "consumed"] },
        "currentLineId": { "type": "string" },
        "receivedAt": { "type": "string", "format": "date-time" },
        "consumedAt": { "type": "string", "format": "date-time" },
        "consumedBy": { "type": "string" },
        "isDamaged": { "type": "boolean" }
      },
      "required": ["coilNumber", "batchId", "diameter", "weight", "status", "receivedAt"]
    },
    "WireReceivingDraft": {
      "title": "Wire Receiving Draft",
      "description": "Cloud-synced in-progress wire receiving batch draft for cross-device persistence.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "currentBatch": { "type": "object" },
        "scannedCoils": { "type": "array" },
        "lastSavedAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["in_progress", "completed", "discarded"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "lastSavedAt"]
    },
    "WireAuditLog": {
      "title": "Wire Audit Log",
      "description": "Security and traceability audit logs for wire receiving and inventory transactions.",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "batchId": { "type": "string" },
        "managerId": { "type": "string" },
        "managerName": { "type": "string" },
        "managerEmail": { "type": "string" },
        "nfNumber": { "type": "string" },
        "supplierName": { "type": "string" },
        "coilsCount": { "type": "integer" },
        "totalWeight": { "type": "number" },
        "storageBayName": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["action", "managerId", "timestamp"]
    },
    "MonthlyProduction": {
      "title": "Monthly Production",
      "description": "Manual input for monthly production tonnage.",
      "type": "object",
      "properties": {
        "year": { "type": "integer" },
        "month": { "type": "integer" },
        "productionTons": { "type": "number", "description": "Actual production in tons." },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": ["year", "month", "productionTons", "updatedAt"]
    },
    "QualityChecklistTemplate": {
      "title": "Quality Checklist Template",
      "description": "Administrator-defined checklist for process quality.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "sectorId": { "type": "string" },
        "frequencyPerShift": { "type": "integer" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "type": { "type": "string", "enum": ["condition", "number", "range", "barcode"] },
              "required": { "type": "boolean" },
              "min": { "type": "number" },
              "max": { "type": "number" }
            },
            "required": ["id", "label", "type", "required"]
          }
        },
        "active": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "sectorId", "frequencyPerShift", "items", "active", "createdAt"]
    },
    "QualityChecklistSubmission": {
      "title": "Quality Checklist Submission",
      "description": "Completed checklist by operator.",
      "type": "object",
      "properties": {
        "templateId": { "type": "string" },
        "sectorId": { "type": "string" },
        "lineId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "shift": { "type": "string" },
        "responses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "itemId": { "type": "string" },
              "value": { "type": "any" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["templateId", "sectorId", "userId", "userName", "shift", "responses", "createdAt"]
    },
    "QualityChecklistOmission": {
      "title": "Quality Checklist Omission",
      "description": "Justification for not completing a checklist.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "templateId": { "type": "string" },
        "templateName": { "type": "string" },
        "lineId": { "type": "string" },
        "lineName": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "shift": { "type": "string" },
        "justification": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "templateId", "date", "shift", "justification", "createdAt"]
    },
    "QualitySector": {
      "title": "Quality Sector",
      "description": "Groups of production lines for quality management.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "lineIds": { "type": "array", "items": { "type": "string" } },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "lineIds", "active", "createdAt"]
    },
    "QualityChecklistOptionSet": {
      "title": "Quality Checklist Option Set",
      "description": "Customizable response sets (e.g., OK/NOK, SIM/NÃO).",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "options", "active", "createdAt"]
    },
    "UserLoginLog": {
      "title": "User Login Log",
      "description": "Log of successful user sign-ins with local details.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "userAgent": { "type": "string" },
        "localTimeStr": { "type": "string" }
      },
      "required": ["userId", "email", "timestamp"]
    },
    "RouteTemplate": {
      "title": "Route Template",
      "description": "Template configuration for operational active routes.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "active": { "type": "boolean" },
        "equipments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" },
              "checkMethod": { "type": "string", "enum": ["ok_notok", "good_average_bad"] },
              "required": { "type": "boolean" }
            },
            "required": ["id", "name", "checkMethod"]
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "equipments", "active"]
    },
    "RouteSubmission": {
      "title": "Route Submission",
      "description": "Inspection record performed by operator for an active route.",
      "type": "object",
      "properties": {
        "templateId": { "type": "string" },
        "templateName": { "type": "string" },
        "operatorName": { "type": "string" },
        "operatorId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "responses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "equipmentId": { "type": "string" },
              "equipmentName": { "type": "string" },
              "status": { "type": "string", "enum": ["ok", "not_ok"] },
              "notes": { "type": "string" },
              "photoUrl": { "type": "string" },
              "observationGenerated": { "type": "boolean" },
              "observationText": { "type": "string" }
            },
            "required": ["equipmentId", "equipmentName", "status"]
          }
        }
      },
      "required": ["templateId", "templateName", "operatorId", "operatorName", "responses", "createdAt"]
    },
    "RouteDraft": {
      "title": "Route Draft",
      "description": "In-progress asset inspection route checklist draft.",
      "type": "object",
      "properties": {
        "templateId": { "type": "string" },
        "templateName": { "type": "string" },
        "operatorId": { "type": "string" },
        "selectedArea": { "type": "string" },
        "selectedShift": { "type": "string" },
        "selectedTeam": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["templateId", "operatorId", "updatedAt"]
    },
    "SafetyObservation": {
      "title": "Safety Observation",
      "description": "Reported safety hazard or non-conformity.",
      "type": "object",
      "properties": {
        "equipmentId": { "type": "string" },
        "equipmentName": { "type": "string" },
        "routeTemplateId": { "type": "string" },
        "routeName": { "type": "string" },
        "reportedBy": { "type": "string" },
        "reportedById": { "type": "string" },
        "description": { "type": "string" },
        "severity": { "type": "string", "enum": ["low", "medium", "high"] },
        "status": { "type": "string", "enum": ["pending", "working", "resolved"] },
        "photoUrl": { "type": "string" },
        "resolutionNotes": { "type": "string" },
        "resolvedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "resolvedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reportedBy", "reportedById", "description", "status", "createdAt"]
    },
    "SafetyCategory": {
      "title": "Safety Category",
      "description": "Category item under What to Observe for safety audit checklist.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "index": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "createdAt"]
    },
    "SafetyArea": {
      "title": "Safety Area",
      "description": "Plant area options for safety observations.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "index": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "createdAt"]
    },
    "Operator": {
      "title": "Operator",
      "description": "Plant operator for safety observation autocomplete list.",
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      },
      "required": ["name"]
    },
    "ConsumableItem": {
      "title": "Consumable Item",
      "description": "Registered consumable stock item like inks, tape, etc.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "unit": { "type": "string", "enum": ["kg", "L", "un", "m"] },
        "currentStock": { "type": "number" },
        "minStock": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "unit", "currentStock", "minStock", "active", "createdAt"]
    },
    "ConsumableLog": {
      "title": "Consumable Log",
      "description": "Log of additions (entries) and consumption (outputs) of consumables.",
      "type": "object",
      "properties": {
        "itemId": { "type": "string" },
        "itemName": { "type": "string" },
        "quantity": { "type": "number" },
        "type": { "type": "string", "enum": ["entry", "consumption"] },
        "lineId": { "type": "string" },
        "lineName": { "type": "string" },
        "usedByUid": { "type": "string" },
        "usedByName": { "type": "string" },
        "processedByUid": { "type": "string" },
        "processedByName": { "type": "string" },
        "shift": { "type": "string", "enum": ["Turno 1", "Turno 2", "Turno 3", "Geral"] },
        "notes": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["itemId", "itemName", "quantity", "type", "processedByUid", "processedByName", "timestamp"]
    },
    "ShiftHandover": {
      "title": "Shift Handover",
      "description": "Report logged at the end of a shift to communicate with the next shift.",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "shift": { "type": "string" },
        "line": { "type": "string", "enum": ["Linha A", "Linha B", "Linha C", "Linha D", "MS1", "MS2"] },
        "sector": { "type": "string", "enum": ["Enfardamento", "Parte Seca", "Parte Úmida"] },
        "status": { "type": "string", "enum": ["normal", "attention", "critical"] },
        "notes": { "type": "string" },
        "pendingTasks": { "type": "string" },
        "stoppedEquipment": { "type": "string" },
        "operatorIn": { "type": "string" },
        "operatorOut": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdByEmail": { "type": "string" },
        "createdByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "shift", "status", "operatorIn", "createdBy", "createdAt"]
    },
    "SecagemProduct": {
      "title": "Secagem Product",
      "description": "Product manufactured in the drying section with physical and package specifications.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "name": { "type": "string" },
        "applyCover": { "type": "boolean" },
        "wireGauge": { "type": "string", "enum": ["2.18", "2.30"] },
        "tieWireQty1": { "type": "integer" },
        "tieWireQty2": { "type": "integer" },
        "bigBaleWireQty": { "type": "integer" },
        "unitWireQty": { "type": "integer" },
        "sealType": { "type": "string" },
        "specialSeal": { "type": "string" },
        "photoUrl": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "name", "applyCover", "wireGauge", "active", "createdAt"]
    },
    "StopReport": {
      "title": "Stop Report",
      "description": "Operational stop report tracking machine stops, cutter speeds, and work fronts.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["programada", "geral"] },
        "date": { "type": "string", "format": "date" },
        "lineId": { "type": "string" },
        "lineName": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
