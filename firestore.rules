rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getMasterEmails() {
      return ['jacksonbjr@gmail.com', 'jackson.junior@eldoradobrasil.com.br'];
    }

    function getMasterUids() {
      return ['EqJVew4PsDhRGGI2GM8C91UkQyp2'];
    }

    function isMaster() {
      return isSignedIn() && (
        request.auth.uid == 'EqJVew4PsDhRGGI2GM8C91UkQyp2' ||
        ('email' in request.auth.token && (
          request.auth.token.email.lower() == 'jacksonbjr@gmail.com' ||
          request.auth.token.email.lower() == 'jackson.junior@eldoradobrasil.com.br'
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isMaster', false) == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('emailHash', '') == 'hash_912e98fd' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('emailHash', '') == 'hash_cc6a0449'
        ))
      );
    }

    function isEmailVerified() {
      return true;
    }

    // Checking domain allowed
    function isDomainAllowed() {
      return isSignedIn() && (
        isMaster() || (
          'email' in request.auth.token &&
          exists(/databases/$(database)/documents/allowed_domains/$( '@' + request.auth.token.email.lower().split('@')[1] ))
        )
      );
    }

    function isApproved() {
      return isMaster() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', '') == 'approved'
      );
    }

    function isNotDisabled() {
      return isMaster() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false) == false
      );
    }

    // Role helpers
    function isAdmin() {
      return isSignedIn() && (
        isMaster() || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
        )
      );
    }

    function isManager() {
      return isSignedIn() && (
        isMaster() || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'manager' ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin')
        )
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_@.-]+$');
    }

    // Brazil/Eldorado Time and Shift Helpers
    function getBrazilHour() {
      return int(string(request.time - duration.value(10800, 's')).split('T')[1].split(':')[0]);
    }

    // Brazil Date
    function getBrazilDate() {
      return string(request.time - duration.value(10800, 's')).split('T')[0];
    }

    function getBrazilShift() {
      return getBrazilHour() >= 0 && getBrazilHour() < 8 ? 'Turno 1' :
             (getBrazilHour() >= 8 && getBrazilHour() < 16 ? 'Turno 2' : 'Turno 3');
    }

    function isUserBlocked() {
      return isSignedIn() && 
             !isMaster() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false) == true || 
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', '') == 'blocked');
    }

    // Users Collection
    match /users/{userId} {
      function isValidUser(data) {
        return data.get('email', '') is string && 
               data.get('displayName', '') is string &&
               data.get('role', 'viewer') in ['admin', 'manager', 'viewer'];
      }

      function isMasterDoc(data) {
        return data.get('isMaster', false) == true ||
               data.get('emailHash', '') == 'hash_912e98fd' ||
               data.get('emailHash', '') == 'hash_cc6a0449';
      }

      allow get: if true;
      allow list: if isApproved();
      
      allow create: if isSignedIn() && (
                      (request.auth.uid == userId && 
                        (
                          isMaster() ||
                          (isValidUser(request.resource.data) &&
                            (
                              (request.resource.data.get('role', 'viewer') == 'viewer' && 
                               request.resource.data.get('status', 'pending') == 'pending' &&
                               request.resource.data.get('disabled', false) == false) || 
                              isMasterDoc(request.resource.data) ||
                              (
                                exists(/databases/$(database)/documents/users_public/$(request.resource.data.emailHash)) &&
                                get(/databases/$(database)/documents/users_public/$(request.resource.data.emailHash)).data.uid != userId &&
                                request.resource.data.role == get(/databases/$(database)/documents/users_public/$(request.resource.data.emailHash)).data.role &&
                                request.resource.data.status == get(/databases/$(database)/documents/users_public/$(request.resource.data.emailHash)).data.status
                              )
                            )
                          )
                        )
                      ) || isAdmin()
                    ) && (request.resource.data.createdAt == request.time || request.resource.data.createdAt is timestamp);

      allow update: if isSignedIn() && (
                      // 1. User updating their own profile
                      (request.auth.uid == userId && 
                        // Master users can update more fields on themselves if they wish, 
                        // but we protect the core identity fields for everyone else.
                        (isMaster() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'isMaster', 'disabled', 'isEmailVerifiedOverride', 'createdAt'])) &&
                        (request.resource.data.updatedAt == request.time || request.resource.data.updatedAt is timestamp)) ||
                      // 2. Admin/Master updates
                      ((isAdmin() || isMaster()) && 
                        // CRITICAL: NO ONE (not even admins) can update a Master Account except the Master themselves
                        (!isMasterDoc(resource.data) || isMaster()) &&
                        (request.resource.data.updatedAt == request.time || request.resource.data.updatedAt is timestamp))
                    );
      
      allow delete: if isMaster() || (isAdmin() && (!isMasterDoc(resource.data)));
    }

    // Public User Lookup for check-email validation
    match /users_public/{emailHash} {
      allow get: if true;
      allow create, update: if isSignedIn() && (
                              (request.auth.uid == request.resource.data.uid) || 
                              isAdmin()
                            );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // Allowed Domains
    match /allowed_domains/{domainId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidId(domainId);
      allow delete: if isMaster() || (isAdmin() && isValidId(domainId));
    }

    // User Login Logs
    match /user_login_logs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn() && 
                    request.resource.data.userId == request.auth.uid && 
                    request.resource.data.timestamp == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // DDS Sessions
    match /dds_sessions/{sessionId} {
      function isValidSession(data) {
        return data.title is string && data.title.size() <= 200 &&
               data.shift in ['Turno 1', 'Turno 2', 'Turno 3'] &&
               data.group in ['A', 'B', 'C', 'D', 'E'] &&
               data.executor is string &&
               (isManager() || data.passcode == '') &&
               data.get('expiresAt', request.time) is timestamp &&
               (data.createdAt == request.time || data.createdAt is timestamp);
      }

      allow get: if isApproved() && isValidId(sessionId);
      allow list: if isApproved();
      allow create: if isApproved() && isValidId(sessionId) && (isValidSession(request.resource.data) || isManager());
      allow update: if isApproved() && isValidId(sessionId) && (isManager() || resource.data.createdBy == request.auth.uid);
      allow delete: if isMaster() || (isApproved() && isValidId(sessionId) && (isManager() || resource.data.createdBy == request.auth.uid));
    }

    // DDS Signatures
    match /dds_signatures/{signatureId} {
      function isValidSignature(data) {
        return data.userId == request.auth.uid &&
               (data.timestamp == request.time || data.timestamp is timestamp) &&
               data.mood in ['happy', 'neutral', 'sad'] &&
               data.sessionTitle is string &&
               data.keys().hasAll(['sessionId', 'sessionTitle', 'userId', 'userName', 'timestamp', 'passcode', 'mood']);
      }

      allow get: if isApproved() && isValidId(signatureId);
      allow list: if isApproved();
      allow create: if isSignedIn() && isNotDisabled() && isValidId(signatureId) && (
                      isValidSignature(request.resource.data) || 
                      isManager() ||
                      isAdmin() ||
                      isMaster()
                    );
      allow update: if isManager() && isValidId(signatureId);
      allow delete: if isMaster() || (isManager() && isValidId(signatureId));
    }

    // Metrics
    match /metrics/{metricId} {
      allow read: if isManager();
      allow create, update: if isAdmin() && isEmailVerified() && isNotDisabled();
      allow delete: if isMaster() || (isAdmin() && isEmailVerified() && isNotDisabled());
    }

    // Forklifts
    match /forklifts/{forkliftId} {
      allow get: if isApproved() && isValidId(forkliftId);
      allow list: if isApproved();
      allow create: if isManager() && isValidId(forkliftId);
      allow delete: if isMaster() || (isManager() && isValidId(forkliftId));
      allow update: if isApproved();
    }

    // Forklift Check Items
    match /forklift_check_items/{itemId} {
      allow get: if isApproved() && isValidId(itemId);
      allow list: if isApproved();
      allow create, update: if isManager() && isValidId(itemId);
      allow delete: if isMaster() || (isManager() && isValidId(itemId));
    }

    // Forklift Checklists
    match /forklift_checklists/{checklistId} {
      allow get: if isApproved() && isValidId(checklistId);
      allow list: if isApproved();
      allow create: if isApproved() && isNotDisabled() && isValidId(checklistId) &&
                      request.resource.data.conductorId == request.auth.uid &&
                      request.resource.data.timestamp == request.time &&
                      request.resource.data.keys().hasAll(['forkliftId', 'forkliftNumber', 'conductorId', 'conductorName', 'status', 'itemResults', 'timestamp']) &&
                      request.resource.data.status in ['normal', 'anormal'];
      allow update: if isManager() && isValidId(checklistId);
      allow delete: if isMaster() || (isManager() && isValidId(checklistId));
    }

    // Forklift Drafts
    match /forklift_drafts/{draftId} {
      allow get: if isApproved() && isValidId(draftId) &&
                    (resource == null || resource.data.conductorId == request.auth.uid);
      allow list: if isApproved() && (resource == null || resource.data.conductorId == request.auth.uid);
      allow create, update: if isApproved() && isNotDisabled() && isValidId(draftId) && 
                          (resource == null || resource.data.conductorId == request.auth.uid);
      allow delete: if isMaster() || (isApproved() && isNotDisabled() && isValidId(draftId) && 
                          (resource != null && resource.data.conductorId == request.auth.uid));
    }

    // Settings
    match /settings/{settingsId} {
      allow read: if isSignedIn();
      allow create, update: if isApproved() && isNotDisabled() && (settingsId != 'global' || isManager());
      allow delete: if isMaster() || isManager();
    }

    // System Config Modules Settings
    match /system_config/{configId} {
      allow read: if isSignedIn() || (configId == 'branding');
      allow create, update: if (isManager() || isAdmin()) && isValidId(configId);
      allow delete: if isMaster() || (isManager() && isValidId(configId));
    }

    // Notifications
    match /notifications/{notificationId} {
      allow get: if isApproved() && isValidId(notificationId);
      allow list: if isApproved();
      allow create: if isApproved() && isNotDisabled();
      allow update: if isManager();
      allow delete: if isMaster() || isManager();
    }

    // Production Lines
    match /production_lines/{lineId} {
      allow read, write: if true;
    }

    // Wire Storage Bays
    match /wire_storage_bays/{bayId} {
      allow get, list: if isApproved();
      allow create, update: if isManager() && isValidId(bayId);
      allow delete: if isMaster() || (isManager() && isValidId(bayId));
    }

    // Wire Suppliers
    match /wire_suppliers/{supplierId} {
      allow get, list: if isApproved();
      allow create, update: if isAdmin() && isValidId(supplierId);
      allow delete: if isMaster() || (isAdmin() && isValidId(supplierId));
    }

    // Wire Batches
    match /wire_batches/{batchId} {
      allow get, list: if isApproved();
      allow create: if isManager() && isValidId(batchId);
      allow update: if isManager() && isValidId(batchId);
      allow delete: if isMaster() || (isAdmin() && isValidId(batchId));
    }

    // Wire Coils
    match /wire_coils/{coilId} {
      allow get, list: if isApproved();
      allow create: if isManager() && isValidId(coilId);
      allow update: if isApproved() && isValidId(coilId);
      allow delete: if isMaster() || (isAdmin() && isValidId(coilId));
    }

    // Monthly Production (Manual Inputs)
    match /monthly_production/{id} {
      function isValidProduction(data) {
        return data.year is int && data.year >= 2024 &&
               data.month is int && data.month >= 1 && data.month <= 12 &&
               data.productionTons is number && data.productionTons >= 0 &&
               data.updatedAt is timestamp;
      }

      allow read: if isApproved();
      allow create, update: if isManager() && isValidId(id) && isValidProduction(request.resource.data);
      allow delete: if isMaster() || (isManager() && isValidId(id));
    }

    // Quality Checklist Templates
    match /quality_checklist_templates/{templateId} {
      allow get: if isApproved() && isValidId(templateId);
      allow list: if isApproved();
      allow create, update: if isManager() && isValidId(templateId);
      allow delete: if isMaster() || (isManager() && isValidId(templateId));
    }

    // Quality Checklist Submissions
    match /quality_checklist_submissions/{submissionId} {
      allow get: if isApproved() && isValidId(submissionId);
      allow list: if isApproved();
      allow create: if isApproved() && isNotDisabled() &&
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.createdAt == request.time;
      allow update: if isManager();
      allow delete: if isMaster() || isManager();
    }

    // Quality Checklist Omissions
    match /quality_checklist_omissions/{omissionId} {
      allow get: if isApproved() && isValidId(omissionId);
      allow list: if isApproved();
      allow create: if isApproved() && isNotDisabled() &&
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.createdAt == request.time;
      allow update: if isManager();
      allow delete: if isMaster() || isManager();
    }

    // Quality Sectors
    match /quality_sectors/{sectorId} {
      allow read: if isApproved();
      allow create, update: if isManager() && isValidId(sectorId);
      allow delete: if isMaster() || (isManager() && isValidId(sectorId));
    }

    // Quality Checklist Options
    match /quality_checklist_options/{optionSetId} {
      allow read: if isApproved();
      allow create, update: if isManager() && isValidId(optionSetId);
      allow delete: if isMaster() || (isManager() && isValidId(optionSetId));
    }

    // Quality Measurement Units
    match /quality_measurement_units/{unitId} {
      allow read, write: if true;
    }

    // Quality Products
    match /quality_products/{productId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin() && isValidId(productId);
    }

    // Quality Settings
    match /quality_settings/{settingId} {
      allow read: if isSignedIn();
      allow create, update: if isApproved() && isNotDisabled();
      allow delete: if isMaster() || isManager();
    }

    // Quality Checklist Drafts
    match /quality_checklist_drafts/{draftId} {
      allow get, list: if isSignedIn() && !isUserBlocked() && (draftId is string && draftId.size() <= 128);
      allow create, update: if isSignedIn() && !isUserBlocked() && (draftId is string && draftId.size() <= 128) && 
                            request.resource.data.userId == request.auth.uid;
      allow delete: if isMaster() || (isSignedIn() && !isUserBlocked() && (draftId is string && draftId.size() <= 128));
    }

    // Route Templates
    match /route_templates/{templateId} {
      allow get, list: if isApproved();
      allow create, update: if isManager() && isValidId(templateId);
      allow delete: if isMaster() || (isManager() && isValidId(templateId));
    }

    // Route Submissions
    match /route_submissions/{submissionId} {
      allow get, list: if isApproved();
      allow create: if isApproved() && isNotDisabled() && isValidId(submissionId) &&
                      request.resource.data.operatorId == request.auth.uid &&
                      request.resource.data.createdAt == request.time;
      allow update: if isManager();
      allow delete: if isMaster() || isManager();
    }

    // Route Drafts
    match /route_drafts/{draftId} {
      allow get: if isSignedIn() && !isUserBlocked() && (draftId is string && draftId.size() <= 128) &&
                    (resource == null || resource.data.operatorId == request.auth.uid);
      allow list: if isSignedIn() && !isUserBlocked() && (resource == null || resource.data.operatorId == request.auth.uid);
      allow create, update: if isSignedIn() && !isUserBlocked() && (draftId is string && draftId.size() <= 128) && 
                          (resource == null || resource.data.operatorId == request.auth.uid) &&
                          request.resource.data.operatorId == request.auth.uid;
      allow delete: if isMaster() || (isSignedIn() && !isUserBlocked() && (draftId is string && draftId.size() <= 128) && 
                          (resource != null && resource.data.operatorId == request.auth.uid));
    }

    // Safety Observations
    match /safety_observations/{observationId} {
      allow get, list: if isApproved();
      allow create: if isApproved() && isNotDisabled() && isValidId(observationId) &&
                      request.resource.data.reportedById == request.auth.uid &&
                      request.resource.data.createdAt == request.time;
      allow update: if isApproved() && isNotDisabled() && isValidId(observationId) && 
                      (isManager() || resource.data.reportedById == request.auth.uid);
      allow delete: if isMaster() || (isManager() && isValidId(observationId));
    }

    // Safety Categories (O Que Observar)
    match /safety_categories/{categoryId} {
      allow get, list: if isApproved();
      allow create, update: if isManager() && isValidId(categoryId);
      allow delete: if isMaster() || (isManager() && isValidId(categoryId));
    }

    // Safety Areas (Areas)
    match /safety_areas/{areaId} {
      allow get, list: if isApproved();
      allow create, update: if isManager() && isValidId(areaId);
      allow delete: if isMaster() || (isManager() && isValidId(areaId));
    }

    // Operators Autocomplete List
    match /operators/{operatorId} {
      allow get, list: if isApproved();
      allow create, update: if isManager() && isValidId(operatorId);
      allow delete: if isMaster() || (isManager() && isValidId(operatorId));
    }

    // Consumable Items
    match /consumable_items/{itemId} {
      allow get, list: if isApproved();
      allow create: if isApproved() && isValidId(itemId);
      allow update: if isApproved() && isValidId(itemId);
      allow delete: if isMaster() || (isManager() && isValidId(itemId));
    }

    // Consumable Logs
    match /consumable_logs/{logId} {
      allow get, list: if isApproved();
      allow create: if isApproved() && isValidId(logId) &&
                      request.resource.data.processedByUid == request.auth.uid &&
                      request.resource.data.timestamp == request.time;
      allow update: if isManager() && isValidId(logId);
      allow delete: if isMaster() || (isManager() && isValidId(logId));
    }

    // Shift Handovers
    match /shift_handovers/{handoverId} {
      allow get, list: if isSignedIn() && !isUserBlocked();
      allow create: if isSignedIn() && !isUserBlocked() && isValidId(handoverId) &&
                      request.resource.data.createdBy == request.auth.uid &&
                      (request.resource.data.createdAt == request.time || request.resource.data.createdAt is timestamp);
      allow update: if isSignedIn() && !isUserBlocked() && isValidId(handoverId) && (
                      isManager() || (
                        resource.data.createdBy == request.auth.uid &&
                        resource.data.date == getBrazilDate() &&
                        resource.data.shift == getBrazilShift()
                      )
                    );
      allow delete: if isMaster() || (isManager() && isValidId(handoverId));
    }

    // Training Courses & Certificates
    match /training_courses/{courseId} {
      allow get, list: if isApproved();
      allow create: if isManager() && isValidId(courseId);
      allow update: if (isManager() || isApproved()) && isValidId(courseId);
      allow delete: if isMaster() || (isManager() && isValidId(courseId));
    }

    // Stops Reports (Controle de Paradas)
    match /stops_reports/{reportId} {
      allow get, list: if isApproved();
      allow create: if isApproved() && isNotDisabled() && isValidId(reportId) &&
                      (isManager() || request.resource.data.userId == request.auth.uid) &&
                      (request.resource.data.createdAt == request.time || request.resource.data.createdAt is timestamp);
      allow update: if isApproved() && isNotDisabled() && isValidId(reportId) &&
                      (isManager() || resource.data.userId == request.auth.uid);
      allow delete: if isMaster() || (isManager() && isValidId(reportId));
    }

    // Overtime Justifications
    match /overtime_justifications/{justificationId} {
      allow get, list: if isApproved() && (isManager() || resource.data.userId == request.auth.uid);
      allow create, update: if isApproved() && isNotDisabled() && (isManager() || request.resource.data.userId == request.auth.uid);
      allow delete: if isManager() || (isApproved() && resource.data.userId == request.auth.uid);
    }

    // Overtime Functions
    match /overtime_functions/{functionId} {
      allow read: if isApproved();
      allow create, update, delete: if isManager();
    }

    // Overtime Areas
    match /overtime_areas/{areaId} {
      allow read: if isApproved();
      allow create, update, delete: if isManager();
    }

    // Work Sectors
    match /work_sectors/{sectorId} {
      allow read, write: if true;
    }

    // Work Functions
    match /work_functions/{functionId} {
      allow read, write: if true;
    }

    // Vacation Requests
    match /vacation_requests/{requestId} {
      allow read: if isApproved();
      allow create: if isApproved() && isNotDisabled() && request.resource.data.userId == request.auth.uid;
      allow update: if isApproved() && isNotDisabled() && (isManager() || resource.data.userId == request.auth.uid);
      allow delete: if isApproved() && isNotDisabled() && (isManager() || resource.data.userId == request.auth.uid);
    }

    // Vacation Queue
    match /vacation_queue/{queueId} {
      allow read: if isApproved();
      allow create, update, delete: if isManager();
    }

    // Maintenance Issues
    match /maintenance_issues/{issueId} {
      allow read, write: if true;
    }

    // Maintenance Equipments
    match /maintenance_equipments/{equipmentId} {
      allow read, write: if true;
    }

    // Maintenance Areas
    match /maintenance_areas/{areaId} {
      allow read, write: if true;
    }

    // Maintenance Inspection Types
    match /maintenance_inspection_types/{typeId} {
      allow read, write: if true;
    }

    // Maintenance Inspection Names
    match /maintenance_inspection_names/{nameId} {
      allow read, write: if true;
    }

    // Maintenance Responsible Centers
    match /maintenance_responsible_centers/{centerId} {
      allow read, write: if true;
    }

    // Maintenance Programming Types
    match /maintenance_programming_types/{typeId} {
      allow read, write: if true;
    }

    // Maintenance Statuses
    match /maintenance_statuses/{statusId} {
      allow read, write: if true;
    }

    // Maintenance Lines
    match /maintenance_lines/{lineId} {
      allow read, write: if true;
    }
  }
}
